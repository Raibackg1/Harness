# Development: real, local embedded PostgreSQL, no cluster and no fake integrations.
NODE_ENV=development
PORT=3000
DATA_DIR=.data/postgres
KUBERNETES_ENABLED=false
MAX_PROJECTS=10
# Execution reservations are enforced across API replicas; expiry is reconciled by the worker.
MAX_RUNNING_PER_USER=2
MAX_RUNNING_TOTAL=20
MAX_RUNTIME_MINUTES=120
# Optional in development; REQUIRED in production. Never commit real values.
# DATABASE_URL=postgresql://user:password@postgres:5432/harness?sslmode=verify-full
# APP_ORIGIN=https://cloud.company.com
# ENCRYPTION_KEY=<openssl rand -hex 32>
# BOOTSTRAP_TOKEN=<openssl rand -hex 32>
# Kubernetes mode additionally requires:
# WORKSPACE_DOMAIN=workspaces.other-domain.net
# WORKSPACE_IMAGE=ghcr.io/your-org/harness-workspace@sha256:<64 hex characters>
# RUNTIME_CLASS=gvisor
# STORAGE_CLASS=your-csi-storage-class
# INGRESS_CLASS=nginx
# TLS_ISSUER=letsencrypt-prod
# PLATFORM_NAMESPACE=harness-system
# INGRESS_NAMESPACE=ingress-nginx
