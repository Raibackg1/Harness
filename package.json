{
  "name": "harness-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted development control plane for isolated Kubernetes workspaces and DeepSeek Harness",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/server/migrate.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "worker": "tsx src/server/worker-entry.ts",
    "start:worker": "node build/server/worker-entry.js",
    "test:gateway": "npm test --prefix runtime",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/middie": "9.3.4",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "dotenv": "18.0.4",
    "fastify": "5.12.5",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "otpauth": "9.5.2",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tldts": "7.4.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wait-on": "9.1.0"
  }
}
